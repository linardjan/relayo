# =============================================================================
# Relayo — пример переменных окружения
#
# Скопируйте файл в .env и заполните пустые значения. Файл .env не коммитить.
#
# Значения рассчитаны на локальную разработку: инфраструктура запущена в
# Docker Compose, сервисы Relayo — из IDE, поэтому везде указан localhost.
# Если сервисы Relayo тоже запускаются в Docker, docker-compose.yml заменяет
# адреса на имена контейнеров (mssql, redis, rabbitmq, minio, seq).
#
# Кто читает переменную:
#   [internal] — Relayo.Internal (внутренняя сеть)
#   [public]   — Relayo.Public (доступен из интернета)
#   [infra]    — только контейнеры инфраструктуры в docker-compose
#   [test-site] — тестовый backend сайта tools/TestSite (только для разработки)
#
# Значения с пометкой GENERATE создаются командой:
#   openssl rand -base64 32
# =============================================================================


# --- Общее -------------------------------------------------------------------

COMPOSE_PROJECT_NAME=relayo
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development


# --- Адреса и порты ----------------------------------------------------------

# [internal] HTTP: API админки. В бою админку раздаёт nginx (deploy/), см. docs/deployment.md
INTERNAL_HTTP_PORT=5100
# [internal] gRPC для публичного сервиса (отдельный порт, HTTP/2)
INTERNAL_GRPC_PORT=5101
# [public] Адрес gRPC внутреннего сервиса. Это единственный путь
# публичного сервиса к данным: в БД он не ходит
INTERNAL_GRPC_URL=http://localhost:5101
# [internal] [public] GENERATE. Общий ключ для вызовов gRPC: внутренний сервис
# отклоняет вызовы без него. Сетевую изоляцию обеспечивает ИБ, ключ — второй рубеж
INTERNAL_GRPC_KEY=

# [public] API и realtime виджета
PUBLIC_HTTP_PORT=5200
# [internal] [public] Внешний адрес публичного сервиса. Подставляется в код
# вставки виджета, на него Telegram и Meta шлют вебхуки
PUBLIC_BASE_URL=http://localhost:5200



# --- MS SQL Server [internal] [infra] ----------------------------------------

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=relayo
# Локально — учётка sa контейнера: ей Relayo создаёт базу при первом запуске.
# В бою — отдельная учётка с правами db_owner на свою базу, см. docs/deployment.md
MSSQL_USER=sa
# [infra] Пароль sa контейнера. SQL Server требует сложный пароль: буквы разного регистра и цифры
MSSQL_PASSWORD=Relayo_dev_Passw0rd
# Локальный SQL Server в Docker использует самоподписанный сертификат. В бою — false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# [infra] Образ сервера. По умолчанию SQL Server 2022 (только amd64). На Mac с Apple Silicon,
# если в Docker не включён Rosetta, используйте Azure SQL Edge (arm64):
# MSSQL_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
# Схема, куда переносятся отключённые секции архива
DB_ARCHIVE_SCHEMA=archive

# [internal] Применять миграции БД при запуске сервиса. При нескольких
# экземплярах это безопасно: EF Core берёт блокировку на время миграции.
# Если базы ещё нет, она создаётся (нужно право CREATE DATABASE)
DB_MIGRATE_ON_START=true


# --- Хранение сообщений, п. 5.1 ТЗ [internal] --------------------------------

# Через сколько месяцев секция сообщений уходит в архив
MESSAGES_ARCHIVE_AFTER_MONTHS=3
# Через сколько месяцев архив удаляется совсем.
# 0 — не удалять (срок пока не определён)
MESSAGES_ARCHIVE_RETENTION_MONTHS=0
# За сколько дней клиент видит историю в виджете
WIDGET_HISTORY_DAYS=30


# --- Redis [internal] [public] [infra] ---------------------------------------
#
# Нужен, когда сервис работает в нескольких экземплярах. Внутренний сервис: общие
# лимиты входа, realtime операторов (SignalR backplane), лимиты отправки в Telegram,
# опрос Telegram одним экземпляром (аренда), сброс кэша токенов ботов на всех.
# Публичный сервис: общие лимиты на IP. Пусто REDIS_HOST — один экземпляр, всё в памяти.
# Если Redis пропал, сервисы работают дальше, но каждый экземпляр сам по себе.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=relayo_dev_password
# TLS до Redis (например, облачный Redis)
REDIS_SSL=false


# --- RabbitMQ [internal] [public] [infra] ------------------------------------

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# [infra] Веб-интерфейс управления
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=relayo

# [internal] [infra] Основной пользователь
RABBITMQ_USER=relayo
RABBITMQ_PASSWORD=relayo_dev_password

# [public] Отдельный пользователь публичного сервиса с правами только на его
# очереди, чтобы взлом публичного сервиса не открывал всю шину
RABBITMQ_PUBLIC_USER=relayo_public
RABBITMQ_PUBLIC_PASSWORD=relayo_public_dev_password


# --- Файловое хранилище: MinIO или любое S3-совместимое [internal] -----------

# Адрес S3 API для сервиса
S3_ENDPOINT=http://localhost:9000
# Адрес, по которому файлы открывает браузер: в бою это reverse proxy.
# На этот адрес выписываются временные ссылки на вложения
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
# MinIO требует path-style адреса: http://host/bucket/key
S3_FORCE_PATH_STYLE=true

# Способ авторизации:
#   keys        — access key и secret key (токен)
#   credentials — логин и пароль пользователя MinIO (через STS)
S3_AUTH_MODE=keys
S3_ACCESS_KEY=relayo
S3_SECRET_KEY=relayo_dev_password
# Нужны только при S3_AUTH_MODE=credentials
S3_USERNAME=
S3_PASSWORD=

# Публичное чтение: файлы виджетов (п. 3.5 ТЗ)
S3_BUCKET_WIDGETS=relayo-widgets
# Закрытые бакеты, доступ только по временным ссылкам
S3_BUCKET_ATTACHMENTS=relayo-attachments
S3_BUCKET_EXPORTS=relayo-exports
# Срок жизни временной ссылки на файл, минуты
S3_PRESIGNED_URL_MINUTES=15

# [infra] Локальное S3-хранилище в Docker. Это RustFS: свежих образов MinIO
# в публичных реестрах больше нет, а Relayo работает с хранилищем по S3 API
MINIO_ROOT_USER=relayo
MINIO_ROOT_PASSWORD=relayo_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# --- Вложения [internal] [public] --------------------------------------------

# Проверяются и в публичном сервисе (сразу при приёме файла),
# и во внутреннем (перед сохранением)
ATTACHMENTS_MAX_SIZE_MB=20
ATTACHMENTS_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,audio/mpeg,audio/ogg,audio/mp4


# --- Вход по своим логинам [internal] ----------------------------------------

JWT_ISSUER=relayo
JWT_AUDIENCE=relayo-admin
# GENERATE. Не короче 32 байт
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# Первый администратор. Создаётся при запуске, если в БД ещё нет
# пользователей и оба значения заданы
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=


# --- Шифрование секретов в БД [internal] -------------------------------------

# GENERATE. Этим ключом шифруются токены каналов и ботов и ключи сайтов.
# Если ключ потерять, все сохранённые токены и ключи придётся вводить заново
SECRETS_ENCRYPTION_KEY=


# --- Active Directory --------------------------------------------------------
#
# Подключение к AD (сервер, служебная учётка, папка с пользователями, роль по
# умолчанию, расписание синхронизации) настраивается в админке:
# Settings → LDAP. Пароль служебной учётки хранится в БД зашифрованным.
#
# [infra] Тестовый AD в Docker (Samba AD DC). Запускается отдельно:
#   docker compose --profile ad up -d
#   docker compose exec samba sh /seed/seed.sh
# Значения для Settings → LDAP — в README, раздел «Проверка входа через AD».
TEST_AD_DOMAIN=EXAMPLE
TEST_AD_REALM=example.local
# Samba требует сложный пароль: буквы разного регистра и цифры
TEST_AD_ADMIN_PASSWORD=Relayo_dev_Passw0rd


# --- Публичный сервис [public] -----------------------------------------------

# Разрешённые источники для CORS в дополнение к доменам сайтов и зеркал из
# админки. Здесь — тестовая страница в VS Code Live Server
PUBLIC_CORS_EXTRA_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Лимиты на одного посетителя в минуту
PUBLIC_RATE_LIMIT_REQUESTS_PER_MINUTE=120
PUBLIC_RATE_LIMIT_MESSAGES_PER_MINUTE=30
PUBLIC_RATE_LIMIT_UPLOADS_PER_MINUTE=10

# Срок жизни одноразовой ссылки для перехода в мессенджер, минуты
LINK_TOKEN_TTL_MINUTES=10
# Допустимое расхождение часов с сайтом при проверке токена клиента, секунды
CLIENT_TOKEN_CLOCK_SKEW_SECONDS=60


# --- Виджет ------------------------------------------------------------------

# [internal] Язык виджета по умолчанию
WIDGET_DEFAULT_LOCALE=en
# [internal] Адрес, откуда браузер загружает файлы виджета.
# Подставляется в код вставки. В бою — через reverse proxy
WIDGET_FILES_BASE_URL=http://localhost:9000/relayo-widgets


# --- Админка (Vite) ----------------------------------------------------------

# Vite берёт только переменные с префиксом VITE_. При сборке их значения
# встраиваются в код, который видит браузер, поэтому секретов здесь быть не может
VITE_API_BASE_URL=http://localhost:5100
VITE_DEFAULT_LOCALE=en


# --- Тестовый сайт: tools/TestSite -------------------------------------------
#
# Работает только при ASPNETCORE_ENVIRONMENT=Development, в остальных
# окружениях эти переменные игнорируются.
#
# При запуске Relayo.Internal создаёт в БД тестовый сайт, его ключ и два
# виджета (по одному на каждый режим идентификации), если их ещё нет.
# TestSite подписывает токены тем же ключом, поэтому всё работает сразу
# после запуска, без ручной настройки в админке.

# [internal] Создавать ли тестовые данные при запуске
DEV_SEED_TEST_SITE=true
# [internal] Код product тестового сайта
TEST_SITE_PRODUCT=test

# [internal] [test-site] Два порта — два «зеркала» сайта. У каждого порта
# свой localStorage, как у разных доменов. Оба адреса заносятся в домены
# тестового сайта. Порт 5500 занят Live Server, поэтому выбраны другие
TEST_SITE_PORT=5300
TEST_SITE_MIRROR_PORT=5301

# [internal] [test-site] Ключ подписи токена клиента (п. 3.3.1 ТЗ)
TEST_SITE_KEY_ID=test-key-1
# GENERATE
TEST_SITE_SECRET=

# [internal] [test-site] Фиксированные id тестовых виджетов
TEST_WIDGET_TOKEN_MODE_ID=00000000-0000-0000-0000-000000000001
TEST_WIDGET_DIRECT_MODE_ID=00000000-0000-0000-0000-000000000002
# Ключи тестовых виджетов: из них имена файлов widget_<ключ>.js в S3 (10 латинских букв или цифр)
TEST_WIDGET_TOKEN_MODE_KEY=testtoken1
TEST_WIDGET_DIRECT_MODE_KEY=testdirect

# [test-site] Клиенты для кнопок «Войти как» на тестовой странице
TEST_SITE_CLIENT_IDS=1001,1002,1003
# [test-site] Срок жизни выдаваемого токена, минуты
TEST_SITE_TOKEN_MINUTES=5


# --- Логи и трассировка [internal] [public] [infra] --------------------------

SEQ_URL=http://localhost:5341
# Пусто — писать без ключа (только для локальной разработки)
SEQ_API_KEY=
# [infra] Веб-интерфейс Seq и пароль admin при первом запуске
SEQ_UI_PORT=8081
SEQ_FIRSTRUN_ADMIN_PASSWORD=relayo_dev_password

# Seq принимает OpenTelemetry напрямую, отдельный коллектор для разработки не нужен.
# Имя сервиса (OTEL_SERVICE_NAME) задаётся в docker-compose для каждого сервиса
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5341/ingest/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf


# --- Мессенджеры -------------------------------------------------------------
#
# Telegram-боты и номера WhatsApp подключаются в админке (их может быть много,
# и они меняются), токены хранятся в БД в зашифрованном виде. Здесь их нет.
#
# [internal] Как Relayo получает сообщения Telegram:
#   webhook — Telegram шлёт их на PUBLIC_BASE_URL/telegram/<id бота>/webhook.
#             Нужен публичный HTTPS-адрес (для локальной проверки — туннель);
#   polling — внутренний сервис сам забирает их у Telegram. Работает без
#             публичного адреса; только для разработки и одного экземпляра.
TELEGRAM_UPDATES_MODE=polling
# [internal] Bot API вызывается из внутреннего сервиса: ему нужен исходящий
# доступ к api.telegram.org. Если ИБ пускает наружу только через прокси:
# TELEGRAM_PROXY_URL=http://proxy.internal:3128
# Свой Bot API server вместо api.telegram.org (обычно не нужен):
# TELEGRAM_API_BASE_URL=https://api.telegram.org
#
# Meta шлёт вебхуки на PUBLIC_BASE_URL и требует публичный HTTPS.
#
# [public] WhatsApp Cloud API (этап 7): секрет приложения Meta для проверки
# подписи вебхуков и токен подтверждения вебхука
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
