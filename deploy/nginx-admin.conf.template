# Админка Relayo. Переменная RELAYO_INTERNAL_URL — адрес HTTP-порта внутреннего сервиса.
# TLS здесь не настроен: его снимает прокси перед этим контейнером (см. docs/deployment.md).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Заголовки безопасности (X-Content-Type-Options и др.) заданы в каждом location с add_header:
    # nginx не наследует add_header уровня server, если в location есть свой.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location /api/ {
        proxy_pass ${RELAYO_INTERNAL_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 25m;
    }

    # Realtime операторов (SignalR, WebSocket)
    location /hubs/ {
        proxy_pass ${RELAYO_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    # Файлы сборки с хешем в имени: кэшируются навсегда
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }

    # Остальное — приложение: index.html без кэша, чтобы новая версия подхватывалась сразу
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }
}
