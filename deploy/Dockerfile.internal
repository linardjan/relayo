# Relayo.Internal: API админки (5100), gRPC для публичного сервиса (5101), фоновые задачи.
# Собирается из корня репозитория: docker compose -f deploy/docker-compose.yml build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props ./
COPY src/Relayo.Contracts/Relayo.Contracts.csproj src/Relayo.Contracts/
COPY src/Relayo.Core/Relayo.Core.csproj src/Relayo.Core/
COPY src/Relayo.ServiceDefaults/Relayo.ServiceDefaults.csproj src/Relayo.ServiceDefaults/
COPY src/Relayo.Internal/Relayo.Internal.csproj src/Relayo.Internal/
RUN dotnet restore src/Relayo.Internal/Relayo.Internal.csproj
COPY src/ src/
RUN dotnet publish src/Relayo.Internal/Relayo.Internal.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 5100 5101
USER app
ENTRYPOINT ["dotnet", "Relayo.Internal.dll"]
