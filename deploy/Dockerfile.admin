# Админка: собранный React-фронтенд в nginx. /api и /hubs nginx передаёт внутреннему сервису,
# поэтому админка и API работают с одного адреса (cookie с refresh-токеном, без CORS).
FROM node:22-bookworm-slim AS build
WORKDIR /repo/web/admin
COPY web/admin/package.json web/admin/package-lock.json ./
RUN npm ci
COPY web/admin/ ./
RUN npm run build

FROM nginx:1.27-alpine
# Шаблон: при запуске nginx подставляет переменные окружения (RELAYO_INTERNAL_URL).
COPY deploy/nginx-admin.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /repo/web/admin/dist /usr/share/nginx/html
ENV RELAYO_INTERNAL_URL=http://relayo-internal:5100
EXPOSE 8080
