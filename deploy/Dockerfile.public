# Relayo.Public: API и realtime виджета, вебхуки мессенджеров (5200). Доступа к БД нет.
# Ядро виджета (core.js) собирается здесь же и раздаётся сервисом из wwwroot/widget.
FROM node:22-bookworm-slim AS widget
WORKDIR /repo/web/widget
COPY web/widget/package.json web/widget/package-lock.json ./
RUN npm ci
COPY web/widget/ ./
# Vite кладёт результат в ../../src/Relayo.Public/wwwroot/widget
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props ./
COPY src/Relayo.Contracts/Relayo.Contracts.csproj src/Relayo.Contracts/
COPY src/Relayo.ServiceDefaults/Relayo.ServiceDefaults.csproj src/Relayo.ServiceDefaults/
COPY src/Relayo.Public/Relayo.Public.csproj src/Relayo.Public/
RUN dotnet restore src/Relayo.Public/Relayo.Public.csproj
COPY src/Relayo.Contracts/ src/Relayo.Contracts/
COPY src/Relayo.ServiceDefaults/ src/Relayo.ServiceDefaults/
COPY src/Relayo.Public/ src/Relayo.Public/
COPY --from=widget /repo/src/Relayo.Public/wwwroot/widget/ src/Relayo.Public/wwwroot/widget/
RUN dotnet publish src/Relayo.Public/Relayo.Public.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 5200
USER app
ENTRYPOINT ["dotnet", "Relayo.Public.dll"]
