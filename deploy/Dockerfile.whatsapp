# Relayo.WhatsApp: шлюз WhatsApp (подключение номеров по QR-коду, протокол WhatsApp Web), 5400.
# Только внутренняя сеть: его вызывает Relayo.Internal, сам он ходит в Internal и на серверы WhatsApp.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY src/Relayo.WhatsApp/package.json src/Relayo.WhatsApp/package-lock.json ./
RUN npm ci
COPY src/Relayo.WhatsApp/tsconfig.json ./
COPY src/Relayo.WhatsApp/src/ src/
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    WHATSAPP_GATEWAY_PORT=5400 \
    WHATSAPP_SESSIONS_DIR=/data/sessions
COPY --from=build /app/node_modules/ node_modules/
COPY --from=build /app/dist/ dist/
COPY src/Relayo.WhatsApp/package.json ./
# Ключи сессий WhatsApp — секретные данные (доступ к номеру): том с правами только для node.
RUN mkdir -p /data/sessions && chown -R node:node /data && chmod 700 /data/sessions
VOLUME /data/sessions
USER node
EXPOSE 5400
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://localhost:5400/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
