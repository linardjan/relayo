# =============================================================================
# Relayo в бою: переменные для deploy/docker-compose.yml
#
# Скопируйте в deploy/.env и заполните. Файл .env не коммитить, права 600:
# в нём пароли и ключи шифрования.
#
# GENERATE — сгенерировать: openssl rand -base64 32
# Подробно о каждой настройке: docs/deployment.md
# =============================================================================

COMPOSE_PROJECT_NAME=relayo-prod
ASPNETCORE_ENVIRONMENT=Production
# Тег образов. При обновлении можно собрать новую версию с другим тегом
RELAYO_VERSION=latest

# --- Адреса и порты на сервере ----------------------------------------------

# Внешний HTTPS-адрес публичного сервиса (за прокси с TLS). Подставляется в код
# вставки виджета, на него Telegram шлёт вебхуки
PUBLIC_BASE_URL=https://chat.example.com
# Где слушает публичный сервис на этом сервере
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=5200
# Где слушает админка (nginx). Перед ней — прокси с HTTPS
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080
# Интерфейс, на котором открыты gRPC внутреннего сервиса (5101) и RabbitMQ (5672)
# для публичного сервиса. Один сервер — 127.0.0.1; два сервера — IP внутреннего
# сервера, доступный только публичному серверу
INTERNAL_BIND=127.0.0.1
INTERNAL_GRPC_HOST_PORT=5101
RABBITMQ_HOST_PORT=5672
# Подсеть контейнеров. Менять, только если пересекается с сетью компании
RELAYO_SUBNET=172.30.0.0/24

# --- Только для публичного сервера, если сервисы на разных серверах ----------
# INTERNAL_GRPC_URL=http://10.0.0.10:5101
# PUBLIC_RABBITMQ_HOST=10.0.0.10

# --- Прокси перед сервисами (через запятую: адреса или сети) -----------------
# Без этого лимиты «на IP» считались бы по адресу прокси, то есть одни на всех
PUBLIC_TRUSTED_PROXIES=
INTERNAL_TRUSTED_PROXIES=

# --- MS SQL Server -----------------------------------------------------------
# Свой сервер MS SQL компании: укажите MSSQL_HOST и не запускайте
# контейнер mssql (см. docs/deployment.md)
# MSSQL_HOST=db.company.local
# MSSQL_PORT=1433
MSSQL_DB=relayo
# Стенд: учётка sa контейнера. Сервер компании: отдельная учётка с db_owner на базу relayo
MSSQL_USER=sa
# GENERATE. SQL Server требует сложный пароль: буквы разного регистра и цифры
MSSQL_PASSWORD=
# true — только для самоподписанного сертификата (контейнер стенда)
MSSQL_TRUST_SERVER_CERTIFICATE=true
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# Редакция SQL Server в контейнере: Developer (не для боя), Express или купленная (Standard, Enterprise)
# MSSQL_PID=Developer
DB_MIGRATE_ON_START=true

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_VHOST=relayo
RABBITMQ_USER=relayo
# GENERATE
RABBITMQ_PASSWORD=
RABBITMQ_PUBLIC_USER=relayo_public
# GENERATE
RABBITMQ_PUBLIC_PASSWORD=

# --- Redis --------------------------------------------------------------------
# Нужен для нескольких экземпляров внутреннего сервиса: общие лимиты входа, realtime операторов
# (SignalR backplane), отправка в Telegram с общими лимитами, опрос Telegram одним экземпляром.
# По умолчанию — контейнер redis. Свой Redis компании: REDIS_HOST, REDIS_PORT, REDIS_SSL=true
# REDIS_HOST=redis.company.local
# REDIS_PORT=6379
# REDIS_SSL=false
# GENERATE
REDIS_PASSWORD=
# Публичный сервис в нескольких экземплярах: свой Redis в публичной зоне для общих лимитов на IP.
# Пусто — лимиты в каждом экземпляре свои
# PUBLIC_REDIS_HOST=
# PUBLIC_REDIS_PORT=6379
# PUBLIC_REDIS_PASSWORD=

# --- Хранилище файлов (S3 / MinIO) -------------------------------------------
# Файлы виджетов widget_<ключ>.js, которые сайты подключают кодом вставки.
# Адрес S3 API для внутреннего сервиса. MinIO компании или контейнер s3
# (профиль storage) — тогда http://s3:9000
S3_ENDPOINT=http://minio.company.local:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=relayo
# GENERATE (для контейнера s3: не короче 8 символов)
S3_SECRET_KEY=
S3_BUCKET_WIDGETS=relayo-widgets
# Внешний адрес, по которому браузеры читают файлы виджетов (через прокси
# с правом только на чтение бакета). Входит в код вставки на сайтах:
# менять после подключения сайтов нельзя
WIDGET_FILES_BASE_URL=https://chat.example.com/w
# Только для контейнера s3 (профиль storage)
S3_BIND=127.0.0.1
S3_HOST_PORT=9000

# --- Ключи --------------------------------------------------------------------
# GENERATE. Подпись токенов входа в админку
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
# GENERATE. Шифрует токены ботов, ключи сайтов и пароль AD в БД.
# ХРАНИТЕ КОПИЮ ОТДЕЛЬНО ОТ БЭКАПОВ БД: без него сохранённые секреты не расшифровать
SECRETS_ENCRYPTION_KEY=
# GENERATE. Общий ключ вызовов gRPC между публичным и внутренним сервисом
INTERNAL_GRPC_KEY=

# --- Первый администратор (создаётся, только если в БД ещё нет пользователей)
BOOTSTRAP_ADMIN_LOGIN=admin
# Не короче 10 символов. После первого входа можно удалить из файла
BOOTSTRAP_ADMIN_PASSWORD=

# --- Виджет и Telegram --------------------------------------------------------
# Дополнительные домены для CORS публичного сервиса (обычно не нужны:
# домены сайтов задаются в админке)
PUBLIC_CORS_EXTRA_ORIGINS=
PUBLIC_RATE_LIMIT_REQUESTS_PER_MINUTE=120
CLIENT_TOKEN_CLOCK_SKEW_SECONDS=60
# webhook — Telegram шлёт сообщения на PUBLIC_BASE_URL (нужен HTTPS);
# polling — внутренний сервис сам забирает их (только один экземпляр)
TELEGRAM_UPDATES_MODE=webhook
# Если внутренний сервис выходит в интернет только через прокси
TELEGRAM_PROXY_URL=

# --- Логи (необязательно) -----------------------------------------------------
# Seq для логов и трассировки. Без него логи только в docker logs
SEQ_URL=
SEQ_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
